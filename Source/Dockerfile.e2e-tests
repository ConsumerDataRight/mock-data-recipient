# Dockerfile for E2E tests

# NB: Ensure playwright version used in CDR.DataRecipient.E2ETests and base image below are same (ie currently 1.60.0)
FROM mcr.microsoft.com/playwright/dotnet:v1.60.0-noble AS build

###############################################################################
# Build E2E tests
###############################################################################
WORKDIR /src

# Default ASPNETCORE_ENVIRONMENT to Release
ENV ASPNETCORE_ENVIRONMENT=Release

# Copy source
COPY . ./

# Install developer certificate
RUN dotnet dev-certs https 

# Build tests
WORKDIR /src/CDR.DataRecipient.E2ETests
RUN dotnet build --configuration Release

# Ensure Playwright browsers matching the installed Microsoft.Playwright package are present,
# regardless of what the base image happens to have pre-installed.
RUN pwsh bin/Release/net10.0/playwright.ps1 install --with-deps chromium

###############################################################################
# Run E2E tests
###############################################################################
ENTRYPOINT ["dotnet", "test", "--configuration", "Release", "--no-build", "--report-trx", "--report-trx-filename", "results.trx", "--results-directory", "/testresults"]
# ENTRYPOINT ["dotnet", "test", "--configuration", "Release", "--no-build", "--filter", "AC04_DynamicClientRegistration", "--logger", "trx;verbosity=detailed;LogFileName=results.trx", "-r", "/testresults"]
# ENTRYPOINT ["tail", "-f", "/dev/null"]
